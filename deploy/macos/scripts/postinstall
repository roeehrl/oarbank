#!/bin/sh
# Oarbank node pkg: runs as root once the payload is in place (docs/design/node-enrollment.md). A package installs; it
# never joins and never needs the join code. Installer gives this script no caller environment, and its output lands
# in /var/log/install.log, which every account can read: nothing here prints a code, a managed value or a file's
# contents.
#
#   - `oarbank-node` on PATH: /usr/local/bin/oarbank-node -> /Library/Oarbank/bin/oarbank-launcher.
#   - The managed-policy job (dev.codonic.oarbank.agent.policy, /Library/LaunchDaemons) is (re)loaded: it joins with an
#     MDM profile's JoinCode or Coordinator, whether the profile came before this pkg or comes after it.
#   - The root helper (dev.codonic.oarbank.agent.helper) through which Oarbank Node.app asks for an administrator to
#     join or leave (docs/design/node-enrollment.md, "macOS elevation"): its authorization rights, with the prompts the
#     system shows, are registered, and its job is (re)loaded; it runs on demand, when the app asks.
#   - The update runner's job (dev.codonic.oarbank.agent.update, PLAN D57; docs/design/fleet-updates.md): (re)loaded,
#     unless it is running, which is when the runner itself is installing this pkg: booting it out would end the
#     install it is in the middle of. Its state directory (logs included) is root's alone. Then
#     `oarbank-launcher update-trust --from-agent` pins the owner anchors the agent pinned as root's update trust,
#     while an administrator installs (it does nothing when trust is pinned already, or the node has no anchors yet).
#   - An upgrade (a node set up in either scope) makes the package's agent the current one (`oarbank-launcher install`:
#     the package is the unit, D57: the launcher, helpers, app, runtime and agent move together), renders the service's
#     job again with the new launcher's keys (`oarbank-launcher service refresh`: a 2.8 job has no ExitTimeOut, so
#     launchd would kill the agent 20 s into stopping its jobs) and restarts it on the new launcher, and restarts a
#     system install's session helpers on the new agent binary: every person's, not only the console's. A system install's session helpers get their socket's
#     directory (/Library/Application Support/Oarbank/run, the service account's) if it is missing.
#   - Otherwise a double-click install (Installer.app: COMMAND_LINE_INSTALL unset; `installer` and MDM set it to 1)
#     with someone at the console and no managed code or address opens Oarbank Node at its join window, as that
#     person. Anything else says how to join from a terminal.
#
# It always exits 0: whatever the network or the console does, the programs are installed.
set -u
BIN=/Library/Oarbank/bin
LABEL=dev.codonic.oarbank.agent
POLICY=dev.codonic.oarbank.agent.policy
HELPER=dev.codonic.oarbank.agent.helper
UPDATE=dev.codonic.oarbank.agent.update
SUPPORT="/Library/Application Support/Oarbank"
APP="/Applications/Oarbank Node.app"
MANAGED="/Library/Managed Preferences/$LABEL.plist"
user=$(/usr/bin/stat -f%Su /dev/console 2>/dev/null || echo root)
uid=$(/usr/bin/id -u "$user" 2>/dev/null || echo 0)
# someone at the console: not the login window (the console is root's then) and not a fast-user-switching gap
console=
[ "$user" != root ] && [ "$user" != loginwindow ] && [ "$uid" -gt 0 ] && console=yes

/bin/mkdir -p /usr/local/bin && /bin/ln -sfn "$BIN/oarbank-launcher" /usr/local/bin/oarbank-node

# the policy job's stderr, root's alone, created before launchd would create it world-readable
log=/var/log/oarbank-policy.log
[ -f "$log" ] || : > "$log"
/usr/sbin/chown root:wheel "$log" 2>/dev/null; /bin/chmod 600 "$log" 2>/dev/null
# bootout first so an upgrade's plist is the one loaded; a bootstrap right after a bootout can find the old job still
# going away (error 5): once more after a moment, and at worst launchd loads it at the next restart
/bin/launchctl bootout "system/$POLICY" 2>/dev/null
/bin/launchctl bootstrap system "/Library/LaunchDaemons/$POLICY.plist" 2>/dev/null \
    || { /bin/sleep 1; /bin/launchctl bootstrap system "/Library/LaunchDaemons/$POLICY.plist" 2>/dev/null; } \
    || echo "Oarbank: the managed-policy job starts at the next restart"
# the helper's rights first (root writes the authorization database without a prompt), then its job, as above
"$BIN/oarbank-node-helper" register-rights >/dev/null 2>&1 \
    || echo "Oarbank: Oarbank Node's administrator rights could not be registered; join with: sudo oarbank-node join"
/bin/launchctl bootout "system/$HELPER" 2>/dev/null
/bin/launchctl bootstrap system "/Library/LaunchDaemons/$HELPER.plist" 2>/dev/null \
    || { /bin/sleep 1; /bin/launchctl bootstrap system "/Library/LaunchDaemons/$HELPER.plist" 2>/dev/null; } \
    || echo "Oarbank: Oarbank Node's helper starts at the next restart"

# the update runner: root's update trust first (the runner it loads reads it), then its job. Its log goes in its state
# directory, made root's alone before launchd would create the file
/bin/mkdir -p "$SUPPORT/update/logs"
/usr/sbin/chown root:wheel "$SUPPORT/update" "$SUPPORT/update/logs" 2>/dev/null
/bin/chmod 700 "$SUPPORT/update" "$SUPPORT/update/logs" 2>/dev/null
"$BIN/oarbank-launcher" update-trust --from-agent >/dev/null 2>&1
# A running runner is the one installing this pkg (installer is its child): it keeps the job it was started from, and
# the next load (a restart) reads the new plist. "state = not running" is a loaded job at rest.
if /bin/launchctl print "system/$UPDATE" 2>/dev/null | /usr/bin/grep -q '^[[:space:]]*state = running'; then
    echo "Oarbank: the update runner is running; its job reloads at the next restart"
else
    /bin/launchctl bootout "system/$UPDATE" 2>/dev/null
    /bin/launchctl bootstrap system "/Library/LaunchDaemons/$UPDATE.plist" 2>/dev/null \
        || { /bin/sleep 1; /bin/launchctl bootstrap system "/Library/LaunchDaemons/$UPDATE.plist" 2>/dev/null; } \
        || echo "Oarbank: the update runner starts at the next restart"
fi

# inbound listeners (docs/design/inbound-listeners.md): with the Application Firewall on, an agent it does not list gets a
# prompt at its first incoming connection, which holds every connection while nobody answers it (measured on macOS 26):
# list the agent as allowed now. A Developer ID-signed agent is matched by its signature, so updates keep the rule.
if /usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate 2>/dev/null | /usr/bin/grep -q "State = [12]" \
        && [ -x "$BIN/oarbank-agent" ]; then
    "$BIN/oarbank-agent" firewall allow >/dev/null 2>&1 || echo "Oarbank: the firewall rule for inbound listeners was not added"
fi

upgraded=
if [ -f "/Library/LaunchDaemons/$LABEL.plist" ]; then
    # the package's agent becomes current before the service restarts on it, owned by the node's account like the rest
    # of its home
    home="$SUPPORT/agent"
    if [ -e "$home/current" ] || [ -L "$home/current" ]; then
        if "$BIN/oarbank-launcher" --home "$home" install "$BIN/oarbank-agent" >/dev/null 2>&1; then
            /usr/sbin/chown -R _oarbank:_oarbank "$home/versions" 2>/dev/null
            /usr/sbin/chown -h _oarbank:_oarbank "$home/current" 2>/dev/null
        else
            echo "Oarbank: the package's agent could not be made current; the service keeps the agent it had"
        fi
    fi
    # the session helpers' socket directory, the service account's and everyone's to enter (svc_launchd.rs): only the
    # first install made it, and a node without it served no helper, so rules missed the people's processes. Made
    # before the service restarts; `service refresh` makes it too
    acct=$(/usr/bin/plutil -extract UserName raw -o - "/Library/LaunchDaemons/$LABEL.plist" 2>/dev/null)
    [ -n "$acct" ] || acct=_oarbank
    /bin/mkdir -p "$SUPPORT/run"
    /usr/sbin/chown "$acct:$acct" "$SUPPORT/run" 2>/dev/null || /usr/sbin/chown "$acct" "$SUPPORT/run" 2>/dev/null
    /bin/chmod 755 "$SUPPORT/run"
    "$BIN/oarbank-launcher" service refresh --system >/dev/null 2>&1 \
        || /bin/launchctl kickstart -k "system/$LABEL" 2>/dev/null
    # every person's session helper restarts on the new agent binary: the console's, and every one running now (fast
    # user switching, screen sharing). A helper left on old code would describe processes for host protection with
    # it. One its job no longer names is ended, and launchd starts the installed one again (KeepAlive)
    helper_uids=$( { for u in $(/usr/bin/who | /usr/bin/awk '$2 == "console" {print $1}' | /usr/bin/sort -u); do
                         /usr/bin/id -u "$u" 2>/dev/null; done
                     /bin/ps -axo uid=,command= | /usr/bin/awk -v a="$BIN/oarbank-agent" '$2 == a && $3 == "session-helper" {print $1}'
                   } | /usr/bin/sort -u)
    for uid in $helper_uids; do
        /bin/launchctl kickstart -k "gui/$uid/$LABEL.session" 2>/dev/null \
            || /usr/bin/pkill -U "$uid" -f "^$BIN/oarbank-agent session-helper" 2>/dev/null
    done
    upgraded=yes
fi
if [ -n "$console" ]; then
    uhome=$(/usr/bin/dscl . -read "/Users/$user" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}')
    if [ -n "$uhome" ] && [ -f "$uhome/Library/LaunchAgents/$LABEL.plist" ]; then
        # the person's own node: the package's agent made current and the LaunchAgent rendered again, as that person,
        # in their session (their HOME names the file)
        /bin/launchctl asuser "$uid" /usr/bin/sudo -u "$user" /usr/bin/env HOME="$uhome" "$BIN/oarbank-launcher" \
            --home "$uhome/Library/Application Support/Oarbank/agent" install "$BIN/oarbank-agent" >/dev/null 2>&1 \
            || echo "Oarbank: the package's agent could not be made current; the service keeps the agent it had"
        /bin/launchctl asuser "$uid" /usr/bin/sudo -u "$user" /usr/bin/env HOME="$uhome" "$BIN/oarbank-launcher" \
            service refresh >/dev/null 2>&1 \
            || /bin/launchctl kickstart -k "gui/$uid/$LABEL" 2>/dev/null
        upgraded=yes
    fi
fi
if [ -n "$upgraded" ]; then
    echo "Oarbank: upgraded; the service restarted on the new launcher"
    exit 0
fi

# A management profile joins the node through the policy job: no join window then. The values only feed the test,
# never the output.
managed=
for key in JoinCode Coordinator; do
    [ -n "$(/usr/bin/plutil -extract "$key" raw -o - "$MANAGED" 2>/dev/null)" ] && managed=yes
done

if [ -z "${COMMAND_LINE_INSTALL:-}" ] && [ -n "$console" ] && [ -z "$managed" ] && [ -d "$APP" ]; then
    # `open` hands the launch to LaunchServices and returns at once (no -W), so it cannot hold the install up; it runs
    # in the foreground because Installer may end this script's process group as soon as the script exits, before a
    # backgrounded `open` has reached LaunchServices. A failure falls through to the terminal hint.
    /bin/launchctl asuser "$uid" /usr/bin/sudo -u "$user" /usr/bin/open -a "$APP" --args --join >/dev/null 2>&1 \
        && exit 0
fi
echo "Installed. Join this Mac with: sudo oarbank-node join"
exit 0
