<?xml version="1.0" encoding="utf-8"?>
<!-- English strings for oarbank.admx (Codonic, Oarbank, Node, Node settings). -->
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                           revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Oarbank</displayName>
  <description>Settings for Oarbank nodes: joining a fleet, what the Oarbank Node app offers, and node settings made stricter on this computer.</description>
  <resources>
    <stringTable>
      <string id="SUPPORTED_Oarbank_2_8">Oarbank agent 2.8 or later</string>
      <string id="SUPPORTED_Oarbank_2_9">Oarbank agent 2.9 or later</string>
      <string id="Codonic">Codonic</string>
      <string id="Oarbank">Oarbank</string>
      <string id="Node">Node</string>
      <string id="Node_Help">How this computer joins an Oarbank fleet. The Oarbank agent reads these settings every 5 seconds while the computer has not joined; a computer that has joined keeps its coordinator.</string>
      <string id="JoinCode">Join code</string>
      <string id="JoinCode_Help">A join code (OB2-…) from the Oarbank console's Add machine. While this computer has not joined, the agent checks the code and joins with it as the system service.

Use a multi-use code that needs your approval in the console (Fleet): every user of this computer can read this setting, and a code that approves machines at once would let anyone who reads it add a machine.

Revoking or expiring the code never removes a computer that has already joined.</string>
      <string id="Coordinator">Coordinator address</string>
      <string id="Coordinator_Help">Join by the coordinator's address instead of a code, for example https://coordinator.example:7443. The computer asks to join and waits; approve it in the console with the code it shows (Fleet, Approve a machine by its code). A join code, when set, is used instead.</string>
      <string id="Name">Node name</string>
      <string id="Name_Help">This computer's name in the fleet when the join code has no label. Not set: the computer's name.</string>
      <string id="Containers">Run container jobs</string>
      <string id="Containers_Help">Enabled: the agent installs what container jobs need (the Virtual Machine Platform and WSL) when it joins. Windows may need a restart before the node offers container jobs.

Disabled or not configured: container prerequisites are installed only when someone asks for them.</string>
      <string id="AllowUserJoin">Allow users to join or leave</string>
      <string id="AllowUserJoin_Help">Disabled: Oarbank Node hides Join this PC and Leave, so only this policy (or an administrator's command line) joins the computer.

Enabled or not configured: a person using the computer can join it with a code from the Oarbank Node app.</string>
      <string id="ShowStatusIcon">Show Oarbank Node in the notification area</string>
      <string id="ShowStatusIcon_Help">Disabled: Oarbank Node shows no icon in the notification area for anyone using this computer and does not start at sign-in. Opening Oarbank Node from the Start menu still opens the join window. The node itself keeps running: it is a Windows service that starts with the computer.

Enabled: the icon is shown and people cannot hide it.

Not configured: each person chooses in Oarbank Node (Show in the notification area; on once they open it).

Either way the setting is greyed out in Oarbank Node with "Managed by" your organization.</string>
      <string id="ManagedByOrganizationName">Organization name</string>
      <string id="ManagedByOrganizationName_Help">The organization shown in Oarbank Node and in the node's status ("Managed by …").</string>
      <string id="NodeSettings">Node settings (tighten-only)</string>
      <string id="NodeSettings_Help">Settings the coordinator sends this computer, made stricter here. These values can only make the coordinator's settings stricter on this computer, never looser: a value looser than the coordinator's has no effect. The Oarbank console shows each one as Managed on this machine. The agent reads them at most once a minute.</string>
      <string id="os_reserve_gb">Memory kept for the system (GB)</string>
      <string id="os_reserve_gb_Help">Memory never offered to jobs, whoever is using the computer, in GB (for example 6 or 6.5). A value lower than the coordinator's has no effect.

This value can only make the coordinator's setting stricter on this computer, never looser; the console shows the setting as Managed on this machine.</string>
      <string id="user_reserve_gb">Memory kept for the person using it (GB)</string>
      <string id="user_reserve_gb_Help">Memory also kept free while someone is using the computer, in GB (for example 8 or 12.5). A value lower than the coordinator's has no effect.

This value can only make the coordinator's setting stricter on this computer, never looser; the console shows the setting as Managed on this machine.</string>
      <string id="mem_in_use_bound">Fit jobs into the memory free now</string>
      <string id="mem_in_use_bound_Help">Enabled: jobs get at most the memory the computer has available now, less the memory guard's floor and 1 GB. Disabled has no effect: the coordinator's setting applies.

This value can only make the coordinator's setting stricter on this computer, never looser; the console shows the setting as Managed on this machine.</string>
      <string id="user_present_slots">Jobs while someone is using this computer</string>
      <string id="user_present_slots_Help">The most jobs at once while someone is at the computer; 0 holds every new job back. A value higher than the coordinator's has no effect.

This value can only make the coordinator's setting stricter on this computer, never looser; the console shows the setting as Managed on this machine.</string>
      <string id="user_idle_s">Idle time before the computer counts as free (seconds)</string>
      <string id="user_idle_s_Help">Seconds without keyboard or mouse input before the computer runs at full capacity (for example 600). A value lower than the coordinator's has no effect.

This value can only make the coordinator's setting stricter on this computer, never looser; the console shows the setting as Managed on this machine.</string>
      <string id="screen_sharing_present">Screen sharing counts as someone using it</string>
      <string id="screen_sharing_present_Help">Enabled: a remote screen sharing session holds jobs back like a person at the keyboard, even without input. Disabled has no effect: the coordinator's setting applies.

This value can only make the coordinator's setting stricter on this computer, never looser; the console shows the setting as Managed on this machine.</string>
      <string id="run_on_battery">Run jobs on battery</string>
      <string id="run_on_battery_Help">Disabled: a laptop on battery power takes no new jobs. Enabled has no effect: the coordinator's setting applies.

This value can only make the coordinator's setting stricter on this computer, never looser; the console shows the setting as Managed on this machine.</string>
      <string id="max_slots">Most jobs at once (slots)</string>
      <string id="max_slots_Help">An upper bound on job slots whatever the hardware allows. A value higher than the coordinator's has no effect.

This value can only make the coordinator's setting stricter on this computer, never looser; the console shows the setting as Managed on this machine.</string>
      <string id="hard_limits">Hard limits</string>
      <string id="hard_limits_Help">Enabled: jobs over their memory or CPU reservation are stopped (Windows Job Objects). Disabled has no effect: the coordinator's setting applies.

This value can only make the coordinator's setting stricter on this computer, never looser; the console shows the setting as Managed on this machine.</string>
      <string id="cpu_cores">CPU cores cap</string>
      <string id="cpu_cores_Help">Caps concurrent jobs times their threads, in cores (for example 4 or 2.5). A value higher than the coordinator's cap has no effect.

This value can only make the coordinator's setting stricter on this computer, never looser; the console shows the setting as Managed on this machine.</string>
      <string id="mem_gb">Memory cap (GB)</string>
      <string id="mem_gb_Help">Memory for jobs and module services, in GB (for example 16 or 12.5). A value higher than the coordinator's cap has no effect.

This value can only make the coordinator's setting stricter on this computer, never looser; the console shows the setting as Managed on this machine.</string>
      <string id="jobs">Concurrent jobs cap</string>
      <string id="jobs_Help">The most jobs running at once. A value higher than the coordinator's cap has no effect.

This value can only make the coordinator's setting stricter on this computer, never looser; the console shows the setting as Managed on this machine.</string>
      <string id="enforce">Cap enforcement</string>
      <string id="enforce_Help">Soft: stop admitting jobs over a cap and let running jobs finish. Hard: also hand back the youngest jobs to fit. Soft has no effect when the coordinator asks for hard.

This value can only make the coordinator's setting stricter on this computer, never looser; the console shows the setting as Managed on this machine.</string>
      <string id="enforce_soft">Soft</string>
      <string id="enforce_hard">Hard</string>
      <string id="vm_mem_gb">VM memory cap for services (GB)</string>
      <string id="vm_mem_gb_Help">Memory for a module's VM service, in GB, applied at its next start. A value higher than the coordinator's cap has no effect.

This value can only make the coordinator's setting stricter on this computer, never looser; the console shows the setting as Managed on this machine.</string>
      <string id="vm_cpus">VM CPUs cap for services</string>
      <string id="vm_cpus_Help">CPUs for a module's VM service, applied at its next start. A value higher than the coordinator's cap has no effect.

This value can only make the coordinator's setting stricter on this computer, never looser; the console shows the setting as Managed on this machine.</string>
      <string id="disk_gb">Disk cache cap (GB)</string>
      <string id="disk_gb_Help">The dataset and image cache on this computer, in GB. A value higher than the coordinator's cap has no effect.

This value can only make the coordinator's setting stricter on this computer, never looser; the console shows the setting as Managed on this machine.</string>
      <string id="staging_mbps">Download bandwidth cap (Mbps)</string>
      <string id="staging_mbps_Help">Bandwidth for dataset downloads, in Mbps (for example 50 or 12.5). A value higher than the coordinator's cap has no effect.

This value can only make the coordinator's setting stricter on this computer, never looser; the console shows the setting as Managed on this machine.</string>
    </stringTable>
    <presentationTable>
      <presentation id="JoinCode">
        <textBox refId="JoinCode">
          <label>Join code:</label>
        </textBox>
      </presentation>
      <presentation id="Coordinator">
        <textBox refId="Coordinator">
          <label>Coordinator address:</label>
        </textBox>
      </presentation>
      <presentation id="Name">
        <textBox refId="Name">
          <label>Node name:</label>
        </textBox>
      </presentation>
      <presentation id="ManagedByOrganizationName">
        <textBox refId="ManagedByOrganizationName">
          <label>Organization name:</label>
        </textBox>
      </presentation>
      <presentation id="os_reserve_gb">
        <textBox refId="os_reserve_gb">
          <label>GB:</label>
        </textBox>
      </presentation>
      <presentation id="user_reserve_gb">
        <textBox refId="user_reserve_gb">
          <label>GB:</label>
        </textBox>
      </presentation>
      <presentation id="user_present_slots">
        <decimalTextBox refId="user_present_slots" defaultValue="1">Jobs:</decimalTextBox>
      </presentation>
      <presentation id="user_idle_s">
        <textBox refId="user_idle_s">
          <label>Seconds:</label>
        </textBox>
      </presentation>
      <presentation id="max_slots">
        <decimalTextBox refId="max_slots" defaultValue="1">Slots:</decimalTextBox>
      </presentation>
      <presentation id="cpu_cores">
        <textBox refId="cpu_cores">
          <label>Cores:</label>
        </textBox>
      </presentation>
      <presentation id="mem_gb">
        <textBox refId="mem_gb">
          <label>GB:</label>
        </textBox>
      </presentation>
      <presentation id="jobs">
        <decimalTextBox refId="jobs" defaultValue="1">Jobs:</decimalTextBox>
      </presentation>
      <presentation id="enforce">
        <dropdownList refId="enforce" noSort="true" defaultItem="1">Enforcement:</dropdownList>
      </presentation>
      <presentation id="vm_mem_gb">
        <textBox refId="vm_mem_gb">
          <label>GB:</label>
        </textBox>
      </presentation>
      <presentation id="vm_cpus">
        <decimalTextBox refId="vm_cpus" defaultValue="1">CPUs:</decimalTextBox>
      </presentation>
      <presentation id="disk_gb">
        <textBox refId="disk_gb">
          <label>GB:</label>
        </textBox>
      </presentation>
      <presentation id="staging_mbps">
        <textBox refId="staging_mbps">
          <label>Mbps:</label>
        </textBox>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
