  "cases": [
    {"name": "path_contains + descendants skips a reused ppid", "match": {"path_contains": "Worker/releases"}, "tree": "descendants", "expected": [10, 11, 12, 60]},
    {"name": "path_contains self", "match": {"path_contains": "Worker/releases"}, "tree": "self", "expected": [10, 60]},
    {"name": "team + bundle, same_team pulls helpers", "match": {"team_id": "EQHXZ8M8AV", "bundle_id": ["com.example.browser"]}, "tree": "same_team", "expected": [20, 21]},
    {"name": "team only", "match": {"team_id": "EQHXZ8M8AV"}, "tree": "self", "expected": [20, 21]},
    {"name": "path prefix + argv regex", "match": {"path_prefix": "/Users/o/venvs/mlx/bin/python", "argv_regex": "train\\.py"}, "tree": "descendants", "expected": [30, 60]},
    {"name": "requirement + descendants", "match": {"requirement": "anchor apple and identifier \"com.apple.dt.Xcode\""}, "tree": "descendants", "expected": [40, 41]},
    {"name": "bundle list", "match": {"bundle_id": ["us.zoom.xos", "com.apple.FaceTime"]}, "tree": "self", "expected": [50]},
    {"name": "name (p_comm)", "match": {"name": "clang"}, "tree": "self", "expected": [41]},
    {"name": "identifier", "match": {"identifier": "com.example.browser.helper"}, "tree": "self", "expected": [21]},
    {"name": "no match", "match": {"bundle_id": ["com.example.none"]}, "tree": "descendants", "expected": []},
    {"name": "path_contains sees arguments", "match": {"path_contains": "eval.py"}, "tree": "self", "expected": [31, 60]},
    {"name": "an unreadable path and arguments count as a match", "match": {"path_prefix": "/opt/trainer/"}, "tree": "self", "expected": [60]},
    {"name": "a readable name that differs is no match, however much is unreadable", "match": {"path_prefix": "/opt/trainer/", "name": "trainer"}, "tree": "self", "expected": []}
