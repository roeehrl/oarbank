    {"pid": 12, "ppid": 11, "start_us": 1200, "path": "/bin/sh", "argv": ["sh", "-c", "x"]},
    {"pid": 13, "ppid": 10, "start_us": 500, "path": "/bin/zsh", "argv": ["zsh"]},
    {"pid": 20, "ppid": 1, "start_us": 2000, "path": "/Applications/Web Browser.app/Contents/MacOS/Web Browser", "team_id": "EQHXZ8M8AV", "signing_id": "com.example.browser", "bundle_id": "com.example.browser", "argv": ["Web Browser"]},
    {"pid": 21, "ppid": 20, "start_us": 2100, "path": "/Applications/Web Browser.app/Contents/Frameworks/Helper", "team_id": "EQHXZ8M8AV", "signing_id": "com.example.browser.helper", "bundle_id": "com.example.browser.helper", "argv": ["Helper", "--type=renderer"]},
    {"pid": 30, "ppid": 1, "start_us": 3000, "path": "/Users/o/venvs/mlx/bin/python", "argv": ["python", "train.py", "--lr", "1e-4"]},
    {"pid": 31, "ppid": 1, "start_us": 3100, "path": "/Users/o/venvs/mlx/bin/python", "argv": ["python", "eval.py"]},
    {"pid": 40, "ppid": 1, "start_us": 4000, "path": "/Applications/Xcode.app/Contents/MacOS/Xcode", "requirements_met": ["anchor apple and identifier \"com.apple.dt.Xcode\""], "argv": ["Xcode"]},
    {"pid": 41, "ppid": 40, "start_us": 4100, "path": "/usr/bin/clang", "argv": ["clang"]},
    {"pid": 50, "ppid": 1, "start_us": 5000, "path": "/Applications/zoom.us.app/Contents/MacOS/zoom.us", "bundle_id": "us.zoom.xos", "argv": ["zoom.us"]},
    {"pid": 60, "ppid": 1, "start_us": 6000, "path": null, "comm": "worker", "argv": null}
